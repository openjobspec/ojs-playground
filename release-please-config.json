{
  "packages": {
    ".": {
      "release-type": "simple",
      "bump-minor-pre-major": true,
      "bump-patch-for-minor-pre-major": false,
      "include-v-in-tag": true,
      "extra-files": [
        {
          "type": "json",
          "path": "npm/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "ui/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "ui/package-lock.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "ui/package-lock.json",
          "jsonpath": "$.packages[''].version"
        }
      ]
    }
  }
}
